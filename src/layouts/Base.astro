---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import '../styles/theme.css'
import '../styles/editor.css'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz-diagram — Diagram-as-code',
  description = 'Diagram-as-code studio. Mermaid live editor, export SVG/PNG, flowchart/sequence/ER/gantt/class templates. 100% client-side — no upload, no signup.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://diagram.oriz.in" />
  </head>
  <body>
    <OzToolShell site="diagram" title="Diagram-as-code" mainClass="dg-container">
      <slot />
    </OzToolShell>
  </body>
</html>
