---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import '../styles/theme.css'
import '../styles/editor.css'

interface Props {
  title?: string
  description?: string
}
const SITE_URL = 'https://diagram.oriz.in'
const {
  title = 'oriz-diagram — free online Mermaid diagram editor, no signup',
  description = 'Free online Mermaid diagram maker — write flowcharts, sequence, ER, Gantt & class diagrams as code and export clean SVG/PNG. 100% in your browser, no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, SITE_URL).href
const ogImage = new URL('/og.png', SITE_URL).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz-diagram',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  url: SITE_URL,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="oriz.in" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f6bff" />
    <script>
      import { registerSW } from 'virtual:pwa-register'
      registerSW({ immediate: true })
    </script>
  </head>
  <body>
    <OzToolShell site="diagram" title="Diagram-as-code" mainClass="dg-container">
      <slot />
    </OzToolShell>
  </body>
</html>
