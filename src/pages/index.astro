---
import Base from '../layouts/Base.astro'
import Editor from '../components/Editor.tsx'
---

<Base>
  <section class="dg-hero">
    <span class="dg-node-badge">diagram-as-code</span>
    <h1 class="dg-hero-title">
      Free online Mermaid diagram editor
    </h1>
    <p class="dg-hero-sub">
      Write flowcharts, sequence, ER, Gantt &amp; class diagrams as text — render live, export clean
      SVG or PNG. 100% in your browser. No upload. No signup.
    </p>
    <div class="dg-hero-cta">
      <a class="dg-btn dg-btn--primary" href="#editor">Open the editor</a>
      <span class="dg-hero-note">Flowchart · Sequence · ER · Gantt · Class · optional AI</span>
    </div>
  </section>

  <div id="editor">
    <Editor client:load />
  </div>

  <section class="dg-notes" aria-label="Why oriz-diagram">
    <div class="dg-note">
      <span class="dg-node-badge">private</span>
      <p>Rendering, validation, and export run client-side — your source is never uploaded and works offline once loaded.</p>
    </div>
    <div class="dg-note">
      <span class="dg-node-badge">portable</span>
      <p>Diagrams are plain Mermaid text. Paste into docs, commit to git, drop a <code>.mmd</code> file — version it like code.</p>
    </div>
    <div class="dg-note">
      <span class="dg-node-badge">optional AI</span>
      <p>Describe a diagram in plain English and get Mermaid back. If a provider is down, the editor keeps working.</p>
    </div>
  </section>

  <Fragment slot="footer">
    <a href="https://mermaid.js.org/" rel="noopener">Mermaid</a>
    <a href="https://github.com/chirag127/oriz-diagram" rel="noopener">Source</a>
  </Fragment>
</Base>

<style>
  .dg-hero { padding-block: var(--oz-space-12) var(--oz-space-6); max-width: 62ch; }
  .dg-hero-title {
    font-size: clamp(2rem, 6vw, 3.4rem);
    letter-spacing: -0.03em;
    margin-block: var(--oz-space-4) var(--oz-space-3);
  }
  .dg-hero-sub { color: var(--oz-muted); font-size: 1.05rem; max-width: 56ch; margin: 0; }
  .dg-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--oz-space-3) var(--oz-space-4);
    margin-top: var(--oz-space-5);
  }
  .dg-hero-cta .dg-btn--primary { text-decoration: none; padding: 0.6rem 1.15rem; }
  .dg-hero-note {
    font-family: var(--oz-font-mono);
    font-size: 0.8rem;
    color: var(--oz-muted);
  }

  #editor { margin-block: var(--oz-space-6); scroll-margin-top: var(--oz-space-4); }

  .dg-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--oz-space-4);
    margin-block: var(--oz-space-8) var(--oz-space-12);
  }
  .dg-note { padding: var(--oz-space-5); }
  .dg-note p { color: var(--oz-muted); margin: var(--oz-space-2) 0 0; font-size: 0.92rem; }
  .dg-note code { font-family: var(--oz-font-mono); background: var(--dg-panel-2); padding: 0.1em 0.35em; border-radius: var(--oz-radius-s); }
</style>
